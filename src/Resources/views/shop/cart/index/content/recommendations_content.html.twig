{% if recommended_products is not empty %}
    <div class="container mb-6" role="region" aria-labelledby="gally-recommendations-heading">
        <h2 class="mb-5" id="gally-recommendations-heading">{{ product_association_type.name }}</h2>

        <div {{ sylius_test_html_attribute('gally-recommendations') }}>
            <div class="products-grid">
                {% for product in recommended_products %}
                    <div>{{ component('sylius_shop:product:card', { product: product, template: '@SyliusShop/product/common/card.html.twig' }) }}</div>
                {% endfor %}
            </div>
        </div>
    </div>

    {% if is_gally_tracking_enabled() %}
        <script>
            window.gallyEvent.push({
                eventType: 'display',
                metadataCode: 'product',
                localizedCatalogCode: '{{ gally.localizedCatalog.code }}',
                payload: JSON.stringify({
                    items: [
                        {% for product in recommended_products %}
                            { entityCode: '{{ product.code }}', display: { position: {{ loop.index0 }} } },
                        {% endfor %}
                    ],
                }),
            })
        </script>
    {% endif %}
{% endif %}

{% if is_gally_enabled() %}
    {% for association_type in gally.getCartRecommendationTypes() %}
        {{ component('gally_shop:cart:recommendation', { productAssociationType: association_type, template: '@GallySyliusPlugin/shop/cart/index/content/recommendations_content.html.twig' }) }}
    {% endfor %}
{% else %}
    {{ component('sylius_shop:product:list', { limit: 4, template: '@SyliusShop/product/common/list.html.twig' }) }}
{% endif %}

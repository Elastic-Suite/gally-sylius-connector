<div{{ attributes }}>
    {% if associated_products is not empty %}
        <h2 class="mb-5">{{ product_association_type.name }}</h2>
        <div {{ sylius_test_html_attribute('product-recommendation', product_association_type.name) }}>
            <div class="products-grid">
                {% for product in associated_products %}
                    <div>{{ component('sylius_shop:product:card', { product: product, template: '@SyliusShop/product/common/card.html.twig' }) }}</div>
                {% endfor %}
            </div>
        </div>
        {% if is_gally_tracking_enabled() %}
            {% set items = [] %}
            {% for product in associated_products %}
                {% set items = items|merge([{ entityCode: product.code, display: { position: loop.index0 } }]) %}
            {% endfor %}
            {% set trackingEvent = {
                eventType: 'display',
                metadataCode: 'product',
                localizedCatalogCode: gally.localizedCatalog.code,
                payload: { items: items }|json_encode,
            } %}
            {#
                Rendered by an ajax-loaded LiveComponent (loading: 'lazy'): its Idiomorph-based
                render inserts <script> tags without executing them, so a plain window.gallyEvent.push
                script here would silently never fire. This data attribute is picked up instead by
                the MutationObserver set up in shop/tracking/init.html.twig.
            #}
            <div class="d-none" data-gally-display-tracking="{{ trackingEvent|json_encode_safe }}"></div>
        {% endif %}
    {% else %}
        {{ component('sylius_shop:product:list', { limit: 4, template: '@SyliusShop/product/common/list.html.twig' }) }}
    {% endif %}
</div>

{% macro placeholder(props) %}
    <div class="product-card-placeholder-line title"></div>
    <div class="products-grid-placeholder">
        {% for _ in 1..4 %}
            <div class="product-card-placeholder">
                <div class="product-card-placeholder-image"></div>
                <div class="product-card-placeholder-line"></div>
                <div class="product-card-placeholder-line short"></div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Gally\SyliusPlugin\Entity\GallyConfiguration" table="gally_configuration">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>
        <field name="baseUrl" type="string" column="base_url" />
        <field name="checkSSL" type="boolean" column="check_ssl" />
        <field name="userName" type="string" column="username" />
        <field name="password" type="string" column="password" />
        <field name="productRecommendationTypeCodes" type="json" column="product_recommendation_type_codes" />
        <field name="productRecommendationMaxSize" type="integer" column="product_recommendation_max_size">
            <options>
                <option name="default">4</option>
            </options>
        </field>
        <field name="cartRecommendationTypeCodes" type="json" column="cart_recommendation_type_codes" />
        <field name="cartRecommendationMaxSize" type="integer" column="cart_recommendation_max_size">
            <options>
                <option name="default">4</option>
            </options>
        </field>
    </mapped-superclass>
</doctrine-mapping>

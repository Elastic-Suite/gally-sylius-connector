<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Gally\SyliusPlugin\Twig\Component\Product\CategoryTrackingComponent">
            <argument type="service" id="request_stack" />
            <argument type="service" id="sylius.repository.taxon" />
            <argument type="service" id="sylius.context.locale" />
            <tag name="sylius.twig_component" key="gally_shop:product:category_tracking"/>
        </service>

        <service id="Gally\SyliusPlugin\Twig\Component\Product\SortOptionComponent">
            <argument type="service" id="Gally\Sdk\Service\SearchManager" />
            <argument type="service" id="request_stack" />
            <argument type="service" id="translator" />
            <argument type="service" id="sylius.context.channel" />
            <tag name="sylius.twig_component"  key="gally_shop:product:sorting"/>
        </service>

        <service id="Gally\SyliusPlugin\Twig\Component\Product\ActiveFiltersComponent">
            <argument type="service" id="Gally\SyliusPlugin\Search\ActiveFilterResolver" />
            <tag name="sylius.twig_component" key="gally_shop:product:active_filters"/>
        </service>

        <service id="Gally\SyliusPlugin\Twig\Component\Product\RecommendationComponent">
            <argument type="service" id="sylius.context.channel" />
            <argument type="service" id="Gally\SyliusPlugin\Config\ConfigManager" />
            <argument type="service" id="Gally\SyliusPlugin\Recommendation\RecommendationFinder" />
            <tag name="sylius.twig_component" key="gally_shop:product:recommendation"/>
        </service>
    </services>
</container>
